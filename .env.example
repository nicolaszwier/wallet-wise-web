VITE_API_URL=http://localhost:3000/api
# TelemetryDeck App ID from https://dashboard.telemetrydeck.com
VITE_TELEMETRYDECK_APP_ID=YOUR-TELEMETRYDECK-APP-ID
# Apple Service ID — must match Apple Developer Console
VITE_APPLE_CLIENT_ID=com.yourapp.web
# Apple does not allow localhost return URLs. For local dev, use ngrok
